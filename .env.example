# Hyperliquid API (public endpoints, no auth required for read-only)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# Yahoo Finance (used for CBOE/OPRA option chain data — no API key needed)
# Uncomment below if using a premium yfinance proxy
# YFINANCE_PROXY=

# Backtest parameters (override defaults)
# BACKTEST_ASSETS=AAPL,NVDA,TSLA,GOOGL
# BACKTEST_FOLDS=3
# BACKTEST_PURGE=2
# BACKTEST_EMBARGO=3

# Output directories
DATA_DIR=data
RESULTS_DIR=results
IMG_DIR=docs/img
